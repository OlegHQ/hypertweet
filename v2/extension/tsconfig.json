{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Type Checking - AI-Friendly Strict Mode */
    "strict": true,
    "exactOptionalPropertyTypes": false, // AI-friendly: allow optional prop flexibility
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": false, // AI-friendly: allow implicit returns in some cases
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false, // AI-friendly: allow dot notation
    "noUncheckedIndexedAccess": false, // AI-friendly: allow normal array/object access
    "noUnusedLocals": false, // AI-friendly: allow temporary variables
    "noUnusedParameters": false, // AI-friendly: allow unused parameters
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,

    /* Emit */
    "declaration": false,
    "sourceMap": true,
    "removeComments": false,
    "importHelpers": false,
    "downlevelIteration": false,

    /* JSX */
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",

    /* Interop Constraints */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    /* Advanced */
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "types": ["chrome", "node"],

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/models": ["./models"],
      "@/scrapers": ["./scrapers"]
    }
  },
  "include": ["./**/*"],
  "exclude": ["node_modules", "dist", "../server"]
}
