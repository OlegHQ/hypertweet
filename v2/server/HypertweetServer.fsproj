<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1. Shared -->
    <Compile Include="src/Shared/Errors.fs" />
    <Compile Include="src/Shared/Config.fs" />
    <Compile Include="src/Shared/Prelude.fs" />
    <Compile Include="src/Shared/Helpers.fs" />
    <Compile Include="src/Shared/Log.fs" />
    <Compile Include="src/Shared/Bson.fs" />
    <Compile Include="src/Shared/Common.fs" />

    <!-- 2. Domain -->
    <Compile Include="src/Domain/Models.fs" />

    <!-- 3. Data (shared repositories) -->
    <Compile Include="src/Data/UserRepository.fs" />

    <!-- 4. Infrastructure -->
    <Compile Include="src/Infrastructure/Jwt.fs" />
    <Compile Include="src/Shared/Http.fs" />

    <Compile Include="src/Domain/DataAccess.fs" />
    <!-- 5. Features -->
    <Compile Include="src/Features/Auth/Types.fs" />
    <Compile Include="src/Features/Auth/Handlers.fs" />
    <Compile Include="src/Features/Tones/Types.fs" />
    <Compile Include="src/Features/Tones/Helpers.fs" />
    <Compile Include="src/Features/Tones/Repository.fs" />
    <Compile Include="src/Features/Tones/Service.fs" />
    <Compile Include="src/Features/Tones/Handlers.fs" />
    <Compile Include="src/Features/Profiles/Handlers.fs" />

    <Compile Include="src/Tracing/Service.fs" />
    <Compile Include="src/AI/PromptDomain.fs" />
    <Compile Include="src/AI/Prompts.fs" />
    <Compile Include="src/AI/Service.fs" />

    <!-- 6. Entry -->
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.1.0" />
    <PackageReference Include="OpenAI" Version="2.8.0" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
    <PackageReference Include="MongoDB.Driver.Core" Version="2.28.0" />
    <PackageReference Include="Giraffe" Version="7.0.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
  </ItemGroup>

</Project>

