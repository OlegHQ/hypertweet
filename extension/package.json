{
  "name": "hypertweet-v2",
  "version": "2.0.0",
  "description": "AI-powered contextual replies for social media platforms",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun ./build.js",
    "watch": "bun ./build.js --watch",
    "dev": "bun run clean && bun run watch",
    "prod": "bun run clean && bun run build",
    "clean": "rimraf dist",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tanstack/react-query": "^5.90.12",
    "framer-motion": "^12.23.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@phaserjs/streamdown-lite": "^1.0.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
