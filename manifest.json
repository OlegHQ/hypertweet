{
  "manifest_version": 3,
  "name": "hypertweet",
  "version": "1.0",
  "description": "Copies tweets and their replies to the clipboard when clicked.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "sidePanel"],
  "host_permissions": ["https://x.com/*", "*://*.linkedin.com/*"],
  "background": {
    "scripts": ["out/background.js"]
  },
  "action": {
    "default_title": "hypertweet"
  },
  "side_panel": {
    "default_path": "out/sidebar.html"
  },
  "sidebar_action": {
    "default_icon": {
      "16": "img/icon-16.png",
      "48": "img/icon-48.png"
    },
    "default_title": "hypertweet",
    "default_panel": "out/sidebar.html",
    "open_at_install": true
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "*://*.linkedin.com/*"],
      "js": ["out/content.js"]
    }
  ],
  "icons": {
    "16": "img/icon-16.png",
    "48": "img/icon-48.png",
    "128": "img/icon-128.png"
  }
}
