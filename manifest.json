{
  "manifest_version": 3,
  "name": "hypertweet",
  "version": "1.0",
  "description": "AI assist for replies. Reply like a pro.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["https://x.com/*"],
  "background": {
    "scripts": ["out/background.js"]
  },
  "action": {
    "default_title": "Copy Tweets"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["out/content.js"]
    }
  ],
  "icons": {
    "16": "img/icon-16.png",
    "48": "img/icon-48.png",
    "128": "img/icon-128.png"
  }
}
