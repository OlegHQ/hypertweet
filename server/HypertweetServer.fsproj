<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Base/Prelude.fs" />
    <Compile Include="Base/Bson.fs" />
    <Compile Include="Base/Log.fs" />
    <Compile Include="Base/Common.fs" />
    <Compile Include="Base/PromptDsl.fs" />
    <Compile Include="HypertweetServer/Config.fs" />
    <Compile Include="HypertweetServer/Models.fs" />
    <Compile Include="HypertweetServer/DataAccess.fs" />
    <Compile Include="HypertweetServer/Auth.fs" />
    <Compile Include="HypertweetServer/Profiles.fs" />
    <Compile Include="HypertweetServer/Tones.fs" />
    <Compile Include="HypertweetServer/Tracing.fs" />
    <Compile Include="HypertweetServer/Prompts.fs" />
    <Compile Include="HypertweetServer/AI.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.1.0" />
    <PackageReference Include="OpenAI" Version="2.8.0" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
    <PackageReference Include="MongoDB.Driver.Core" Version="2.28.0" />
    <PackageReference Include="Giraffe" Version="7.0.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
  </ItemGroup>

</Project>
