{
  "name": "copy-tweets",
  "version": "1.0.0",
  "description": "Browser extension for copying tweets",
  "type": "module",
  "scripts": {
    "dev": "bun ./build.ts --watch",
    "dev:chrome": "bun ./build.ts --watch --chrome",
    "build": "bun ./build.ts --all",
    "format": "prettier --write ./src"
  },
  "dependencies": {
    "@twind/core": "^1.1.3",
    "@twind/preset-autoprefix": "^1.0.7",
    "@twind/preset-tailwind": "^1.1.4",
    "@types/chrome": "^0.0.260",
    "@types/webextension-polyfill": "^0.10.0",
    "bun": "^1.2.12",
    "compromise": "^14.14.4",
    "openai": "^4.97.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stopword": "^3.1.4",
    "webextension-polyfill": "^0.10.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.12",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@types/stopword": "^2.0.3",
    "prettier": "^3.5.3",
    "typescript": "^5.3.3"
  }
}
